{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "count": {
        "format": "uint32",
        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
      },
      "destination": {
        "anyOf": [
          {
            "maxLength": 512,
            "pattern": "^[\\u0000-\\u007f]*(?![\\s\\S])"
          },
          {
            "maxLength": 256,
            "pattern": "^[\\u0000-\\u07ff]*(?![\\s\\S])"
          },
          {
            "maxLength": 170,
            "pattern": "^[\\u0000-\\ud7ff\\ue000-\\uffff]*(?![\\s\\S])"
          },
          {
            "maxLength": 128,
            "pattern": "^(?:[^\\ud800-\\udfff]|[\\ud800-\\udbff][\\udc00-\\udfff])*(?![\\s\\S])"
          }
        ],
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "expected_project_revision": {
        "pattern": "^(0|[1-9][0-9]{0,19})$",
        "type": "string"
      },
      "idempotency_key": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[\\u0000-\\u007f]*(?![\\s\\S])",
        "type": "string"
      },
      "project_id": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[\\u0000-\\u007f]*(?![\\s\\S])",
        "type": "string"
      },
      "seed": {
        "pattern": "^(0|[1-9][0-9]{0,19})$",
        "type": "string"
      }
    },
    "required": [
      "project_id",
      "count",
      "seed",
      "idempotency_key",
      "expected_project_revision",
      "destination"
    ],
    "type": "object"
  },
  "output": {
    "$defs": {
      "ArchyError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/$defs/ErrorCode"
          },
          "field": {
            "description": "JSON-style dotted field path; `$` denotes the document itself.",
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retriable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "field",
          "retriable"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "INVALID_SCHEMA",
          "INVALID_GEOMETRY",
          "CONSTRAINT_FAIL",
          "BACKEND_UNAVAILABLE",
          "BACKEND_TIMEOUT",
          "ARTIFACT_INVALID",
          "REVISION_CONFLICT",
          "PERMISSION_DENIED",
          "INTERNAL_ERROR"
        ],
        "type": "string"
      },
      "MutationData": {
        "additionalProperties": false,
        "properties": {
          "all_required_checks_passed": {
            "type": "boolean"
          },
          "exhaustion_explanations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "path": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "variant_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "project_id",
          "run_id",
          "revision",
          "path",
          "variant_ids",
          "all_required_checks_passed",
          "exhaustion_explanations"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/$defs/MutationData"
          },
          "error": {
            "type": "null"
          },
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok",
          "data",
          "error"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "#/$defs/ArchyError"
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "ok",
          "data",
          "error"
        ],
        "type": "object"
      }
    ]
  }
}
