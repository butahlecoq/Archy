{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "cursor": {
        "maxLength": 256,
        "pattern": "^[\\u0000-\\u007f]*(?![\\s\\S])",
        "type": [
          "string",
          "null"
        ]
      },
      "limit": {
        "format": "uint32",
        "maximum": 100,
        "minimum": 1,
        "type": [
          "integer",
          "null"
        ]
      },
      "objective": {
        "anyOf": [
          {
            "maxLength": 128,
            "pattern": "^[\\u0000-\\u007f]*(?![\\s\\S])"
          },
          {
            "maxLength": 64,
            "pattern": "^[\\u0000-\\u07ff]*(?![\\s\\S])"
          },
          {
            "maxLength": 42,
            "pattern": "^[\\u0000-\\ud7ff\\ue000-\\uffff]*(?![\\s\\S])"
          },
          {
            "maxLength": 32,
            "pattern": "^(?:[^\\ud800-\\udfff]|[\\ud800-\\udbff][\\udc00-\\udfff])*(?![\\s\\S])"
          }
        ],
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "project_id": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[\\u0000-\\u007f]*(?![\\s\\S])",
        "type": "string"
      },
      "run_ids": {
        "items": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[\\u0000-\\u007f]*(?![\\s\\S])",
          "type": "string"
        },
        "maxItems": 100,
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "project_id",
      "run_ids",
      "objective"
    ],
    "type": "object"
  },
  "output": {
    "$defs": {
      "ArchyError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/$defs/ErrorCode"
          },
          "field": {
            "description": "JSON-style dotted field path; `$` denotes the document itself.",
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retriable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "field",
          "retriable"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "INVALID_SCHEMA",
          "INVALID_GEOMETRY",
          "CONSTRAINT_FAIL",
          "BACKEND_UNAVAILABLE",
          "BACKEND_TIMEOUT",
          "ARTIFACT_INVALID",
          "REVISION_CONFLICT",
          "PERMISSION_DENIED",
          "INTERNAL_ERROR"
        ],
        "type": "string"
      },
      "PrerequisiteData": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/$defs/PrerequisiteData"
          },
          "error": {
            "type": "null"
          },
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok",
          "data",
          "error"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "#/$defs/ArchyError"
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "ok",
          "data",
          "error"
        ],
        "type": "object"
      }
    ]
  }
}
