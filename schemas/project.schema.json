{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "units": {
      "type": "string",
      "enum": [
        "m",
        "mm",
        "cm",
        "ft"
      ]
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "width_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "polygon_xy": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "polygon_xy_m": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "north_deg": {
          "type": "number"
        }
      },
      "required": []
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storeys": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "floor_to_floor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "floor_to_floor_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_gfa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_gfa_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_gfa_hard": {
          "type": "boolean"
        }
      },
      "required": [
        "storeys"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "max_height",
              "min_edge_setback"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "value_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "m",
                  "mm",
                  "cm",
                  "ft"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string"
          },
          "authority": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "source"
        ]
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "shapes": {
          "type": "array",
          "items": {
            "enum": [
              "rectangle",
              "l_shape"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "count",
        "seed",
        "shapes"
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "units",
    "site",
    "brief",
    "constraints"
  ],
  "description": "Draft structural input contract. Core validation additionally requires exactly one dimension representation, finite positive SI values, rectangle geometry and consistent hard bounds. SI aliases require effective units=m. Optional dimension fields may be null but do not satisfy semantic requirements."
}
