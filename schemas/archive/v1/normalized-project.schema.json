        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ConstraintKind"
        },
        "source": {
          "type": "string"
        },
        "value_m": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "value_m",
        "source",
        "authority"
      ],
      "type": "object"
    },
