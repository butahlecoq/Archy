      "additionalProperties": false,
      "properties": {
        "north_angle_deg": {
          "format": "double",
          "type": "number"
        },
        "polygon_xy_m": {
          "items": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
