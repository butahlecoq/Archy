      "type": "string"
    },
    "Generation": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "shapes": {
          "items": {
            "$ref": "#/$defs/Shape"
          },
          "type": "array"
        }
      },
      "required": [
        "count",
        "seed",
        "shapes"
      ],
      "type": "object"
    },
    "NormalizedBrief": {
