{
  "$defs": {
    "AttemptDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "duplicates": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rejections": {
          "items": {
            "$ref": "#/$defs/RejectionSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "rejections",
        "duplicates"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "INVALID_SCHEMA",
        "INVALID_GEOMETRY",
        "CONSTRAINT_FAIL",
        "BACKEND_UNAVAILABLE",
        "BACKEND_TIMEOUT",
        "ARTIFACT_INVALID",
        "REVISION_CONFLICT",
        "PERMISSION_DENIED",
        "INTERNAL_ERROR"
      ],
      "type": "string"
    },
    "RejectionPhase": {
      "enum": [
        "footprint",
        "variant"
      ],
      "type": "string"
    },
    "RejectionSummary": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/RejectionPhase"
        }
      },
      "required": [
        "phase",
        "code",
        "field",
        "message",
        "count"
      ],
      "type": "object"
    },
    "Shape": {
      "enum": [
        "rectangle",
        "l_shape"
      ],
      "type": "string"
    },
    "ShapeParameters": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "depth_m": {
              "format": "double",
              "type": "number"
            },
            "origin_xy_m": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "shape": {
              "const": "rectangle",
              "type": "string"
            },
            "width_m": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "shape",
            "origin_xy_m",
            "width_m",
            "depth_m"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "depth_m": {
              "format": "double",
              "type": "number"
            },
            "notch_depth_m": {
              "format": "double",
              "type": "number"
            },
            "notch_width_m": {
              "format": "double",
              "type": "number"
            },
            "origin_xy_m": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "shape": {
              "const": "l_shape",
              "type": "string"
            },
            "width_m": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "shape",
            "origin_xy_m",
            "width_m",
            "depth_m",
            "notch_width_m",
            "notch_depth_m"
          ],
          "type": "object"
        }
      ]
    },
    "Variant": {
      "additionalProperties": false,
      "properties": {
        "floor_to_floor_m": {
          "format": "double",
          "type": "number"
        },
        "footprint_xy_m": {
          "items": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "generation_algorithm": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/ShapeParameters"
        },
        "project_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "storeys": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "id",
        "seed",
        "generation_algorithm",
        "shape",
        "parameters",
        "footprint_xy_m",
        "storeys",
        "floor_to_floor_m"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm_version": {
      "type": "string"
    },
    "attempt_diagnostics": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttemptDiagnostics"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempts": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "exhaustion_explanations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "requested_count": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/Variant"
      },
      "type": "array"
    }
  },
  "required": [
    "variants",
    "requested_count",
    "attempts",
    "algorithm_version",
    "exhaustion_explanations"
  ],
  "title": "GenerationResult",
  "type": "object"
}
